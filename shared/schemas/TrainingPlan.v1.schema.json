{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kriscoach.local/schemas/TrainingPlan.v1.schema.json",
  "title": "TrainingPlan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "revision", "date", "title", "estimated_minutes", "safety_gates", "exercises"],
  "properties": {
    "schema_version": { "const": "TrainingPlan.v1" },
    "plan_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "date": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "estimated_minutes": { "type": "integer", "minimum": 1, "maximum": 300 },
    "goal": { "type": "string", "maxLength": 500 },
    "safety_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exercise_id", "order", "name", "equipment_variant", "sets", "target_reps", "rest_seconds"],
        "properties": {
          "exercise_id": { "type": "string", "format": "uuid" },
          "order": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "equipment_variant": { "type": "string", "minLength": 1, "maxLength": 120 },
          "target_weight_kg": { "type": ["number", "null"], "minimum": 0, "maximum": 1000 },
          "sets": { "type": "integer", "minimum": 1, "maximum": 20 },
          "target_reps": { "type": "integer", "minimum": 1, "maximum": 200 },
          "rest_seconds": { "type": "integer", "minimum": 0, "maximum": 900 },
          "notes": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
          "alternative": { "type": ["string", "null"], "maxLength": 200 }
        }
      }
    },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
